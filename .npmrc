# cPanel compatibility fixes
legacy-peer-deps=true
audit=false
fund=false
# Force npm to install into the project directory, not cPanel's nodevenv virtualenv.
# Without this, cPanel's node environment symlinks node_modules to
# /home/<user>/nodevenv/public_html/<app>/<nodeversion>/lib/node_modules
# which Turbopack/Webpack can't resolve correctly (symlink outside project root).
install-strategy=hoisted
# Limit concurrent network connections during install (reduces RAM on shared hosting)
maxsockets=1
# Disable unnecessary post-install scripts from other packages
ignore-scripts=false
