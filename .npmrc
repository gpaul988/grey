# cPanel npm configuration — SKIP ALL NATIVE BUILDS
# ============================================================================
# The shared hosting environment cannot handle native module compilation.
# This config tells npm to:
# 1. Skip ALL postinstall/build scripts (ignore-scripts=true)
# 2. Use prebuilt binaries only (if available)
# 3. Fail gracefully if prebuilds aren't available
# 4. Reduce parallelism to prevent OOM

# CRITICAL: Skip all npm scripts (no native builds)
ignore-scripts=true

# Reduce parallelism
maxsockets=1

# Cache & offline
prefer-offline=true
offline=false

# Production
omit=dev

# Don't fail if a package has no prebuilt binary
fetch-retries=2
fetch-timeout=60000

# Avoid peer dependency hell
legacy-peer-deps=false
