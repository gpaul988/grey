# npm configuration — OPTIMIZED FOR LOCAL (Windows) & cPanel
# ============================================================================
# This config handles:
# 1. better-sqlite3 prebuilt binaries (avoids node-gyp / Visual Studio requirement)
# 2. whisper-node is optional — EPERM on Windows path-too-long is non-fatal
# 3. Legacy peer deps for compatibility
# 4. Reduced parallelism for cPanel shared hosting

# ── better-sqlite3 prebuilt binaries ──────────────────────────────────────────
# Pulls prebuilt .node binaries for win32/linux/darwin — no C++ toolchain needed
better_sqlite3_binary_host=https://github.com/WiseLibs/better-sqlite3/releases/download
better_sqlite3_binary_host_mirror=https://github.com/WiseLibs/better-sqlite3/releases/download

# Reduce parallelism (critical for cPanel shared hosting)
maxsockets=1

# Cache & offline mode - prefer cached packages
prefer-offline=true
offline=false

# Do NOT omit dev dependencies - the build process needs them!
# @types/*, TypeScript, eslint are required during build
# This should ONLY be set via --omit=dev CLI flag when needed for production
# omit=dev  ← REMOVED: Build fails without dev dependencies

# Allow peer dependencies to resolve (common in monorepos/complex projects)
legacy-peer-deps=true

# Don't fail if a package has no prebuilt binary
fetch-retries=2
fetch-timeout=60000

# Parallel operations safety
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Lockfile settings
update-notifier=false
