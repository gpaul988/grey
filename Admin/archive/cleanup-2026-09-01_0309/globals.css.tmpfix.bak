@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
    --brand-color: #2dd4bf;
    --brand-deep: #14b8a6;
    --brand-soft: #ecfeff;
    --brand-soft-strong: #ccfbf1;
    --brand-ink: #0f172a;
    /* force page-accent to brand-deep (teal) */
    --page-accent: #14b8a6;
    --page-accent-rgb: 20, 184, 166;
    --surface: #f7fffe;
    --surface-strong: #edfdfb;
    --glass: rgba(255, 255, 255, 0.72);
    --glass-border: rgba(20, 184, 166, 0.18);
    --shadow-soft: 0 24px 80px rgba(15, 23, 42, 0.08);
}

/* Dark theme variable overrides (applies when .dark is present or data-theme="dark") */
:root.dark, .dark, [data-theme="dark"] {
   /* use teal brand for dark mode accents */
   --brand-color: #14b8a6;
   --brand-deep: #0d9488;
   --brand-soft: #071226;
   --brand-soft-strong: #021126;
   --brand-ink: #e6eef6; /* readable ink on dark */
   --page-accent: #14b8a6;
   --page-accent-rgb: 20, 184, 166;
   --surface: #05060d; /* dark surfaces */
   --surface-strong: #071026;
   --glass: rgba(2, 6, 23, 0.62);
   --glass-border: rgba(6,182,212,0.12);
   --shadow-soft: 0 24px 80px rgba(2, 6, 23, 0.6);
}

/* Improve default text/background contrast in dark mode */
.dark body {
   background: radial-gradient(circle at top left, rgba(6,182,212,0.06), transparent 22%),
               radial-gradient(circle at bottom right, rgba(6,182,212,0.04), transparent 20%),
               linear-gradient(180deg, #05070d 0%, #071026 100%);
   color: var(--brand-ink);
}

/* Ensure glassy components in dark mode use darker glass and visible borders */
.dark .gx-card,
.dark .gx-glass,
.dark .gx-chip,
.dark .gx-glow-border,
.dark .grey-neon-border {
   background: rgba(2,6,23,0.6) !important;
   border: 1px solid rgba(6,182,212,0.08) !important;
   box-shadow: 0 12px 34px rgba(0,0,0,0.6) !important;
   color: var(--brand-ink) !important;
}

/* Make links and small text a bit brighter in dark mode */
.dark a, .dark p, .dark li, .dark span, .dark input, .dark button {
   color: #e6eef6;
}

/* Slightly stronger placeholders in dark mode */
.dark ::placeholder { color: rgba(230,238,246,0.6) !important; }

/* Form placeholder + focus contrast overrides (dark mode) to remediate contrast issues flagged by axe */
.dark input::placeholder, .dark textarea::placeholder, .dark .placeholder-slate-500::placeholder, .dark .placeholder-slate-400::placeholder {
  color: rgba(255,255,255,0.72) !important;
}
.dark input:focus, .dark textarea:focus, .dark select:focus, .dark .focus\:border-cyan-400:focus {
  border-color: rgba(20,184,166,0.95) !important;
  box-shadow: 0 0 0 4px rgba(20,184,166,0.10) !important;
  outline: none !important;
}
/* Ensure any placeholder classes that Tailwind generated to 'placeholder-slate-500' map to visible color */
.placeholder-slate-500::placeholder, .placeholder-slate-400::placeholder { color: rgba(255,255,255,0.75) !important; }

/* Force high-contrast placeholders and input text on dark glass or black backgrounds */
input::placeholder, textarea::placeholder, .grey-search__input::placeholder, [class*="bg-black"]::placeholder {
  color: rgba(255,255,255,0.88) !important;
}
input, textarea, select, .grey-search__input {
  color: var(--brand-ink) !important;
}
/* For dark surfaces ensure inputs show white text */
:root.dark input, :root.dark textarea, :root.dark select, :root.dark .grey-search__input {
  color: #ffffff !important;
}

/* Make header search input a solid high-contrast control (avoids underlying gradient bleed) */
.grey-search__input {
  background: rgba(2,6,23,0.96) !important;
  border-radius: 9999px !important;
  padding-left: 8px !important;
  padding-right: 8px !important;
  color: #ffffff !important;
}

/* Enforce dark-mode non-transparent input backgrounds for better contrast */
:root.dark input[class*="bg-black"], :root.dark input[class*="bg-black/"], :root.dark input[class*="bg-black"] ,
:root.dark input[class*="bg-black/30"], :root.dark textarea[class*="bg-black"], :root.dark select[class*="bg-black"] {
  background: rgba(2,6,23,0.88) !important;
  color: #ffffff !important;
}

/* Improve contrast for feature pills and badges that may still use slate backgrounds */
[class*="bg-slate-800"], [class*="bg-slate-900"], [class*="bg-slate-700"] {
  color: #ffffff !important;
}
/* Also ensure small pill text is bold and readable */
[class*="rounded-full"][class*="px-3"][class*="py-1"] {
  font-weight: 600 !important;
  letter-spacing: 0.02em;
}

/* Normalize non-teal accents to teal via attribute-selector overrides.
   This keeps Tailwind class usage but visually replaces cyan/indigo/purple/pink/orange accents with teal. */
[class*="cyan-"] , [class*="bg-cyan"], [class*="text-cyan"], [class*="border-cyan"], [class*="from-cyan"], [class*="via-cyan"], [class*="to-cyan"], [class*="ring-cyan"], [class*="focus:ring-cyan"], [class*="hover:bg-cyan"] {
  --_teal-rgba: rgba(var(--page-accent-rgb), 1);
}
[class*="text-cyan"] { color: var(--brand-deep) !important; }
[class*="bg-cyan"] { background-color: rgba(var(--page-accent-rgb), 0.12) !important; background-image: none !important; }
[class*="border-cyan"] { border-color: rgba(var(--page-accent-rgb), 0.36) !important; }
[class*="from-cyan"], [class*="via-cyan"], [class*="to-cyan"] { background-image: linear-gradient(135deg, rgba(var(--page-accent-rgb),1), rgba(var(--page-accent-rgb),0.75)) !important; }

[class*="indigo-"], [class*="bg-indigo"], [class*="text-indigo"], [class*="border-indigo"], [class*="from-indigo"], [class*="via-indigo"], [class*="to-indigo"] {
}
[class*="text-indigo"] { color: var(--brand-deep) !important; }
[class*="bg-indigo"] { background-color: rgba(var(--page-accent-rgb), 0.10) !important; background-image: none !important; }
[class*="border-indigo"] { border-color: rgba(var(--page-accent-rgb), 0.30) !important; }
[class*="from-indigo"], [class*="via-indigo"], [class*="to-indigo"] { background-image: linear-gradient(135deg, rgba(var(--page-accent-rgb),1), rgba(var(--page-accent-rgb),0.8)) !important; }

[class*="purple-"], [class*="bg-purple"], [class*="text-purple"], [class*="border-purple"], [class*="from-purple"], [class*="via-purple"], [class*="to-purple"] {
}
[class*="text-purple"] { color: var(--brand-deep) !important; }
[class*="bg-purple"] { background-color: rgba(var(--page-accent-rgb), 0.10) !important; background-image: none !important; }
[class*="border-purple"] { border-color: rgba(var(--page-accent-rgb), 0.30) !important; }
[class*="from-purple"], [class*="via-purple"], [class*="to-purple"] { background-image: linear-gradient(135deg, rgba(var(--page-accent-rgb),1), rgba(var(--page-accent-rgb),0.8)) !important; }

[class*="pink-"], [class*="bg-pink"], [class*="text-pink"], [class*="border-pink"] { color: var(--brand-deep) !important; background-color: rgba(var(--page-accent-rgb),0.10) !important; border-color: rgba(var(--page-accent-rgb),0.28) !important; }
[class*="orange-"], [class*="bg-orange"], [class*="text-orange"], [class*="border-orange"] { color: var(--brand-deep) !important; background-color: rgba(var(--page-accent-rgb),0.10) !important; border-color: rgba(var(--page-accent-rgb),0.28) !important; }

/* Catch common utility usages (hover/focus/ring) */
[class*="hover:bg-indigo"], [class*="hover:bg-cyan"], [class*="hover:bg-purple"], [class*="hover:bg-pink"], [class*="hover:bg-orange"] { background-color: rgba(var(--page-accent-rgb), 0.14) !important; }
[class*="hover:text-indigo"], [class*="hover:text-cyan"], [class*="hover:text-purple"], [class*="hover:text-pink"], [class*="hover:text-orange"] { color: var(--brand-deep) !important; }

/* Ensure focus rings use teal */
[class*="focus:ring-indigo"], [class*="focus:ring-cyan"], [class*="focus:ring-purple"], [class*="focus:ring-pink"], [class*="focus:ring-orange"] { box-shadow: 0 0 0 4px rgba(var(--page-accent-rgb), 0.12) !important; }


/* Ensure decorative overlays (aurora, scanlines, background grids) sit behind primary content */
.pointer-events-none.fixed.inset-0,
.pointer-events-none.fixed.inset-0 *,
.grey-aurora,
.grey-scanline,
.gx-aurora,
.gx-grid,
.gx-noise-overlay,
.gx-hero-scan,
.gx-scanline,
.gx-orbit,
.gx-orbit-reverse,
body::before,
body::after {
   z-index: 0 !important;
   pointer-events: none !important;
}

/* Ensure main content sits above overlays */
#main-content,
main[id="main-content"] {
   position: relative;
   z-index: 20;
}

/* Force readable default text color across the UI (respects dark-mode overrides via :root.dark) */
/* Targets non-actionable/readable text while avoiding CTA/button text overrides */
html, body, #main-content, main, .prose, .page-copy, .content, .text-body,
p, li, ul, ol, dd, dt, span, h1, h2, h3, h4, h5, h6, a, label,
input, textarea, select, .gx-terminal-text, .gx-chip, .gx-card, .gx-glass {
    color: var(--brand-ink) !important;
}

/* Specific: keep header and nav above everything */
header {
   z-index: 60;
}

html {
    color-scheme: light;
    scroll-behavior: smooth;
}

body {
    color: var(--brand-ink);
    /* Subtle background so content remains legible */
    background:
        radial-gradient(circle at top left, rgba(20, 184, 166, 0.06), transparent 22%),
        radial-gradient(circle at bottom right, rgba(20, 184, 166, 0.04), transparent 20%),
        linear-gradient(180deg, #f6fbfb 0%, #f0f9fb 100%);
    font-feature-settings: "ss01", "cv01";
    font-size: 17px;
}

p,
li,
ul,
ol,
dd,
dt,
.prose p,
.page-copy p,
.content p,
.body-copy,
.text-body {
    font-size: 1.06rem;
    line-height: 1.8;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(15, 23, 42, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.02) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(circle at center, black 35%, transparent 100%);
    z-index: 0;
}

body:has(.store-root) {
    background: #ffffff;
}

body:has(.store-root)::before,
body:has(.store-root)::after {
    display: none !important;
}

* {
    box-sizing: border-box;
}

img {
    max-width: 100%;
    display: block;
}

a, button, [role="button"] {
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
}

a:hover, button:hover, [role="button"]:hover {
    transform: translateY(-1px);
}

::selection {
    background: rgba(20, 184, 166, 0.26);
    color: var(--brand-ink);
}

/* Stronger placeholder color in light mode for contrast */
::placeholder { color: rgba(15,23,42,0.45) !important; }

body::before,
body::after {
    opacity: 0.18;
    filter: blur(10px);
}

body::before {
    background:
        radial-gradient(circle at 15% 20%, rgba(20, 184, 166, 0.04), transparent 24%),
        radial-gradient(circle at 75% 10%, rgba(15, 118, 110, 0.03), transparent 22%),
        radial-gradient(circle at 55% 80%, rgba(20, 184, 166, 0.03), transparent 25%);
}

body::after {
    opacity: 0.12;
    background-image: linear-gradient(rgba(15, 23, 42, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.025) 1px, transparent 1px);
    background-size: 40px 40px;
}

.grey-glass,
.gx-card,
.gx-chip,
.gx-glow-border,
.gx-scanline,
.grey-search__field,
.grey-search__panel {
    border-radius: 20px !important;
}

.gx-card,
.gx-chip,
.gx-glow-border,
.gx-scanline,
.grey-search__field,
.grey-search__panel,
.grey-neon-border,
.grey-glass {
    /* stronger, more opaque glass to keep inner text readable */
    background: rgba(255, 255, 255, 0.92) !important;
    border: 1px solid rgba(20, 184, 166, 0.10) !important;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06) !important;
    backdrop-filter: blur(12px);
}

/* Stronger headings and readable copy */
h1, h2, h3, h4, h5, h6 {
    color: var(--brand-ink) !important;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.prose h1, .prose h2, .prose h3 { line-height: 1.05; }

/* Focus-visible for keyboard users */
:focus-visible {
  outline: 3px solid rgba(20,184,166,0.32);
  outline-offset: 3px;
  border-radius: 6px;
}

/* Ensure links and small interactive text are visible */
a { color: var(--brand-ink); text-decoration: underline; text-decoration-color: rgba(20,184,166,0.14); }
a:hover { color: #0b1720; }

/* Button and brand background contrast hardening */
.bg-brand, .btn-brand, .fx-button.brand, .premium-cta, .btn-brand, .button.brand, .brand-link {
  background: linear-gradient(135deg, var(--brand-color), var(--brand-deep)) !important;
  color: #ffffff !important;
  font-weight: 700 !important;
}
/* Ensure small text on brand backgrounds remains readable */
.bg-brand small, .bg-brand .text-sm, .fx-button.brand small, .btn-brand small {
  color: #ffffff !important;
  font-weight: 700 !important;
  font-size: 0.95rem !important;
}

/* Keep CTA/button styles intact but ensure high contrast text */
button, .button, [role="button"] { color: inherit; }

.gx-card::before,
.gx-glow-border::before,
.gx-scanline::before,
.gx-scanline::after,
.grey-neon-border::after {
    display: none !important;
    animation: none !important;
}

.gx-gradient-text,
.grey-neon-text {
    background: linear-gradient(135deg, #0f172a 0%, #0f766e 55%, #0f172a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
}

.gx-chip {
    background: rgba(20, 184, 166, 0.06) !important;
    border-color: rgba(20, 184, 166, 0.18) !important;
    color: #0f172a !important;
    box-shadow: none !important;
}

.gx-chip .gx-dot,
.gx-chip-page-accent .gx-dot-page-accent,
.gx-chip-cyan .gx-dot-cyan,
.gx-chip-purple .gx-dot-purple,
.gx-chip-orange .gx-dot-orange {
    box-shadow: none !important;
    animation: none !important;
}

.gx-grid,
.gx-aurora {
    opacity: 0.35 !important;
    filter: blur(3px);
}

.gx-grid::before {
    background-size: 50px 50px;
}

.gx-scanline {
    opacity: 0.08 !important;
}

.premium-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 34px rgba(15, 23, 42, 0.06);
}

.premium-cta,
.premium-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    height: 48px;
    padding: 0 1.4rem;
    border-radius: 9999px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
}

.premium-cta {
    background: linear-gradient(135deg, #2dd4bf 0%, #14b8a6 100%);
    color: white;
    box-shadow: 0 16px 38px rgba(45, 212, 191, 0.25);
}

.premium-secondary {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    backdrop-filter: blur(10px);
}

.glass-panel {
    background: rgba(255, 255, 255, 0.68);
    border: 1px solid rgba(20, 184, 166, 0.12);
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow-soft);
}

::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-thumb {
    background-color: var(--page-accent);
    border-radius: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

.constant-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hover-button {
    position: relative;
    padding: 1em 2em;
    background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(0, 128, 255, 0.5), transparent 100%);
    outline: none;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.3s ease;
}

.hover-button:hover {
    background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(0, 128, 255, 0.8), transparent 80%);
}

.mobile-menu {
    overflow-y: scroll; /* Enable vertical scrolling */
    -ms-overflow-style: none; /* Hide scrollbar for IE and Edge */
    scrollbar-width: none; /* Hide scrollbar for Firefox */
}

.mobile-menu::-webkit-scrollbar {
    display: none; /* Hide scrollbar for WebKit-based browsers */
}

/* Default cursor for the entire page */
/* Keep page overflow-x hidden to avoid horizontal scroll from decorative FX. */
body {
    cursor: default;
    overflow-x: hidden;
}

/* Custom cursor for the carousel */
.carousel-container {
    cursor: grab;
    position: relative;
}

.carousel-container:active {
    cursor: grabbing;
}

.carousel-container .custom-cursor {
    position: fixed;
    min-width: 112px;
    height: 112px;
    padding: 0 1rem;
    background: rgba(2, 6, 23, 0.72);
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(45, 212, 191, 0.35);
    box-shadow: 0 0 40px -10px rgba(45, 212, 191, 0.55);
    backdrop-filter: blur(20px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.carousel-container .custom-cursor-arrow {
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0;
    color: #2dd4bf;
}

/* .hpointer: utility class for hover/pointer elements using brand teal */
.hpointer {
    color: #14b8a6; /* teal-500 */
    cursor: pointer;
    transition: color 0.15s ease;
}
.hpointer:hover {
    color: #0d9488; /* slightly deeper teal on hover */
}

/* Show custom cursor only inside the carousel */
.carousel-container.active .custom-cursor {
    opacity: 1;
}

.carousel-image {
    margin: 0; /* Remove extra margin */
    padding: 0; /* Remove extra padding */
}

.company-carousel .slick-list {
    overflow: visible;
    margin: 0 -18px;
}

.company-carousel .slick-track {
    display: flex;
    align-items: center;
}

.company-carousel .slick-slide {
    padding: 0 18px;
    opacity: 0.45;
    transform: scale(0.92);
    transition: opacity 0.35s ease, transform 0.35s ease;
}

.company-carousel .slick-slide.slick-active {
    opacity: 1;
    transform: scale(1);
}

.company-carousel .slick-slide > div {
    height: 100%;
    margin: 0 -10px;
}

.carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    height: auto;
}

.track {
    display: flex;
    animation: scrollLeft 20s linear infinite;
}

.image {
    flex-shrink: 0;
    width: 170px;
    height: auto;
    margin-right: 50px; /* Add spacing between images */
}

@keyframes scrollLeft {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-80%);
    }
}

header {
    transition: background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* css */
/* Add these rules (append to ../app/globals.css) */

/* Contact page scoped accent rules */
.contact-page {
    --page-color: var(--page-accent);
}

.contact-page .gx-gradient-text,
.contact-page .fx-chip,
.contact-page .gx-hero-title,
.contact-page h1, .contact-page h2, .contact-page h3, .contact-page h4 {
    color: var(--page-color) !important;
}

.contact-page button,
.contact-page .fx-button,
.contact-page .btn {
    background-color: var(--page-color) !important;
    border-color: var(--page-color) !important;
    color: white !important;
}

/* Keep ghost/outline variants readable */
.contact-page .fx-button[variant="ghost"], .contact-page .fx-button.variant-ghost,
.contact-page .btn.ghost {
    background: transparent !important;
    color: var(--page-color) !important;
    border-color: var(--page-color) !important;
}

.contact-page .icon,
.contact-page .map-pin,
.contact-page svg {
    color: var(--page-color) !important;
    fill: currentColor !important;
}

.contact-page .fx-holo-card,
.contact-page .holo-card {
    --accent: var(--page-color);
    box-shadow: 0 4px 20px rgba(var(--page-accent-rgb), 0.08);
}

/* Anchors and buttons inside business info */
.contact-page a.contact-link {
    color: var(--page-color) !important;
}
.contact-page a.contact-link:hover {
    text-decoration: underline;
}

.contact-page .contact-btn {
    background-color: var(--page-color) !important;
    border-color: var(--page-color) !important;
    color: white !important;
}
.contact-page .contact-btn:hover {
    filter: brightness(0.95);
}

.contact-page .contact-accent {
    color: var(--page-color) !important;
}

/* Brand color overrides — keep the whole frontend aligned to teal-400 */
.text-brand,
.text-brand-color,
.text-teal-300, .text-teal-400, .text-teal-500, .text-teal-600, .text-teal-700,
.text-cyan-300, .text-cyan-400, .text-cyan-500, .text-cyan-600,
.text-sky-300, .text-sky-400, .text-sky-500, .text-sky-600,
.text-emerald-300, .text-emerald-400, .text-emerald-500, .text-emerald-600,
.text-blue-300, .text-blue-400, .text-blue-500, .text-blue-600,
.text-indigo-300, .text-indigo-400, .text-indigo-500, .text-indigo-600,
.text-violet-300, .text-violet-400, .text-violet-500, .text-violet-600,
