<%- contentFor('html_attribute') %>
<%- contentFor('extra_css') %>
<style>.media-card img{width:100%;height:140px;object-fit:cover;border-radius:10px;background:#0f172a}.media-card{position:relative}.media-card .del{position:absolute;top:8px;right:8px}.copy-url{cursor:pointer}</style>
<%- contentFor('content') %>

<%- include('./partials/page-title', { title: title, subtitle: 'Content' }) %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="card-title mb-0"><i class="ti ti-photo me-1"></i> Media Library <span class="badge bg-primary-subtle text-primary ms-1"><%= media.length %></span></h4>
                <label class="btn btn-sm btn-primary mb-0"><i class="ti ti-upload"></i> Upload image<input type="file" id="up" accept="image/*" hidden></label>
            </div>
            <div class="card-body">
                <div class="row g-3" id="grid">
                    <% if (!media.length) { %><div class="col-12 text-center text-muted py-4">No assets yet. Upload your first image.</div><% } %>
                    <% media.forEach((m) => { %>
                    <div class="col-6 col-md-3 col-lg-2 media-card">
                        <img src="<%= m.url %>" title="<%= m.filename %>">
                        <button class="btn btn-sm btn-danger del btn-del" data-id="<%= m.id %>"><i class="ti ti-trash"></i></button>
                        <div class="fs-11 text-muted text-truncate mt-1 copy-url" data-url="<%= m.url %>" title="Click to copy URL"><i class="ti ti-copy"></i> <%= m.url %></div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('extra_javascript') %>
<%- include('./partials/admin-api-helper') %>
<script>
(function () {
    const F=(id)=>document.getElementById(id);
    F('up').addEventListener('change', async (e) => {
        const file=e.target.files[0]; if (!file) return;
        const fd=new FormData(); fd.append('image', file);
        const csrf=document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')||'';
        AdminAPI.toast('Uploading…');
        const r = await fetch('/admin/api/upload/media', {method:'POST', headers:{'x-csrf-token':csrf}, body:fd}).then(r=>r.json()).catch(()=>({ok:false}));
        if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Upload failed', true);
    });
    document.querySelectorAll('.btn-del').forEach(b => b.addEventListener('click', async () => { if (!confirm('Delete asset?')) return; const r=await AdminAPI.del('/media/'+b.dataset.id); if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true); }));
    document.querySelectorAll('.copy-url').forEach(c => c.addEventListener('click', () => { navigator.clipboard.writeText(location.origin+c.dataset.url).then(()=>AdminAPI.toast('URL copied')); }));
})();
</script>
