<%- contentFor('html_attribute') %>
<%- contentFor('extra_css') %>
<style>
    .ad-thumb{width:74px;height:46px;object-fit:cover;border-radius:8px;background:#0f172a}
    .stat-pill{font-variant-numeric:tabular-nums}
    .ad-preview{border-radius:16px;overflow:hidden;position:relative;min-height:150px;display:flex;align-items:center;padding:20px;color:#fff;
        background:linear-gradient(120deg,#0d9488,#6d28d9);box-shadow:0 14px 40px -16px rgba(45,212,191,.6)}
    .ad-preview.image-bg{background-size:cover;background-position:center}
    .ad-preview .ov{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,6,15,.78),rgba(2,6,15,.25));z-index:0}
    .ad-preview .pv-inner{position:relative;z-index:1}
    .share-btn{width:34px;height:34px;display:inline-grid;place-items:center;border-radius:9px;color:#fff;text-decoration:none}
</style>
<%- contentFor('content') %>

<%- include('./partials/page-title', { title: title, subtitle: 'Marketing' }) %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="card-title mb-0"><i class="ti ti-speakerphone me-1"></i> Ads &amp; Adverts <span class="badge bg-primary-subtle text-primary ms-1"><%= ads.length %></span></h4>
                <button class="btn btn-sm btn-primary" id="btnNew"><i class="ti ti-plus"></i> New advert</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-centered mb-0 align-middle">
                    <thead class="bg-light bg-opacity-50">
                        <tr><th style="width:90px">Creative</th><th>Title</th><th>Placement</th><th>Status</th><th>Schedule</th><th class="text-center">Impr.</th><th class="text-center">Clicks</th><th class="text-center">CTR</th><th class="text-end">Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (!ads.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No adverts yet. Create your first one.</td></tr><% } %>
                        <% ads.forEach((a) => { const ctr = a.impressions ? Math.round((a.clicks/a.impressions)*1000)/10 : 0; %>
                        <tr>
                            <td><% if (a.image) { %><img src="<%= a.image %>" class="ad-thumb"><% } else { %><span class="ad-thumb d-inline-grid" style="place-items:center;color:#64748b"><i class="ti ti-photo"></i></span><% } %></td>
                            <td class="fw-medium"><%= a.title %><div class="text-muted fs-12 text-truncate" style="max-width:230px"><%= a.body %></div></td>
                            <td><span class="badge bg-info-subtle text-info"><%= a.placement %></span></td>
                            <td><span class="badge bg-<%= a.status==='published'&&a.active?'success':'secondary' %>-subtle text-<%= a.status==='published'&&a.active?'success':'secondary' %>"><%= a.status==='published'&&a.active?'Live':(a.status||'draft') %></span></td>
                            <td class="fs-12 text-muted"><%= a.starts_at ? a.starts_at.slice(0,10) : '—' %> → <%= a.ends_at ? a.ends_at.slice(0,10) : '∞' %></td>
                            <td class="text-center stat-pill"><%= a.impressions %></td>
                            <td class="text-center stat-pill"><%= a.clicks %></td>
                            <td class="text-center stat-pill"><%= ctr %>%</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-soft-secondary btn-share" data-caption="<%- (a.share_caption||a.title).replace(/"/g,'&quot;') %>" data-link="<%- (a.link_url||'').replace(/"/g,'&quot;') %>" title="Share to social"><i class="ti ti-share"></i></button>
                                <button class="btn btn-sm btn-soft-info btn-dup" data-id="<%= a.id %>" title="Duplicate"><i class="ti ti-copy"></i></button>
                                <button class="btn btn-sm btn-soft-primary btn-edit"
                                    data-json="<%- JSON.stringify(a).replace(/"/g,'&quot;') %>"><i class="ti ti-edit"></i></button>
                                <button class="btn btn-sm btn-soft-danger btn-del" data-id="<%= a.id %>"><i class="ti ti-trash"></i></button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Ad Modal -->
<div class="modal fade" id="aModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom"><h5 class="modal-title" id="mTitle">New advert</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="f_id">
                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label fw-medium">Title <span class="text-danger">*</span></label><input id="f_title" class="form-control" placeholder="e.g. 30% off cloud migration this month"></div>
                            <div class="col-12"><label class="form-label fw-medium">Body</label><textarea id="f_body" class="form-control" rows="2" placeholder="Short supporting line"></textarea></div>
                            <div class="col-12"><label class="form-label fw-medium">Creative image</label>
                                <div class="input-group"><input id="f_image" class="form-control" placeholder="Paste image URL or upload →"><label class="btn btn-soft-primary mb-0"><i class="ti ti-upload"></i><input type="file" id="f_file" accept="image/*" hidden></label></div>
                                <div class="form-text" id="upStatus">Upload or paste a URL. Recommended 1200×420.</div>
                            </div>
                            <div class="col-md-6"><label class="form-label fw-medium">CTA label</label><input id="f_cta" class="form-control" value="Learn more"></div>
                            <div class="col-md-6"><label class="form-label fw-medium">CTA link</label><input id="f_link" class="form-control" placeholder="https://..."></div>
                            <div class="col-12"><label class="form-label fw-medium">Social share caption</label><textarea id="f_share" class="form-control" rows="2" placeholder="Caption used when sharing to social"></textarea></div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="row g-3">
                            <div class="col-6"><label class="form-label fw-medium">Placement</label><select id="f_placement" class="form-select"><option value="home_banner">Home banner</option></select></div>
                            <div class="col-6"><label class="form-label fw-medium">Variant</label><select id="f_variant" class="form-select"><option value="gradient">Gradient</option><option value="image">Image</option><option value="minimal">Minimal</option></select></div>
                            <div class="col-6"><label class="form-label fw-medium">Status</label><select id="f_status" class="form-select"><option value="draft">Draft</option><option value="published">Published</option></select></div>
                            <div class="col-6"><label class="form-label fw-medium">Sort order</label><input id="f_sort" type="number" class="form-control" value="0"></div>
                            <div class="col-6"><label class="form-label fw-medium">Starts</label><input id="f_starts" type="date" class="form-control"></div>
                            <div class="col-6"><label class="form-label fw-medium">Ends</label><input id="f_ends" type="date" class="form-control"></div>
                            <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="f_active" checked><label class="form-check-label fw-medium" for="f_active">Active</label></div></div>
                            <div class="col-12"><label class="form-label fw-medium">Live preview</label>
                                <div class="ad-preview" id="preview"><div class="ov" id="pvOv" style="display:none"></div><div class="pv-inner"><div class="fw-bold fs-18" id="pvTitle">Title</div><div class="fs-13 opacity-75" id="pvBody"></div><span class="btn btn-light btn-sm mt-2" id="pvCta">Learn more</span></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="btnSave"><i class="ti ti-device-floppy me-1"></i>Save advert</button></div>
        </div>
    </div>
</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-bottom"><h5 class="modal-title">Share advert</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body text-center">
                <p class="text-muted fs-13">One click opens the platform composer pre-filled. Review &amp; post.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3" id="shareBtns"></div>
                <button class="btn btn-soft-secondary btn-sm w-100" id="copyCap"><i class="ti ti-copy me-1"></i>Copy caption (for Instagram)</button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('extra_javascript') %>
<%- include('./partials/admin-api-helper') %>
<script>
(function () {
    const modal = new bootstrap.Modal('#aModal');
    const shareModal = new bootstrap.Modal('#shareModal');
    const F = (id) => document.getElementById(id);

    function renderPreview() {
        const pv = F('preview'); const img = F('f_image').value.trim(); const variant = F('f_variant').value;
        F('pvTitle').textContent = F('f_title').value || 'Title';
        F('pvBody').textContent = F('f_body').value || '';
        F('pvCta').textContent = F('f_cta').value || 'Learn more';
        if ((variant === 'image') && img) { pv.classList.add('image-bg'); pv.style.backgroundImage = `url('${img}')`; F('pvOv').style.display='block'; }
        else { pv.classList.remove('image-bg'); pv.style.backgroundImage=''; F('pvOv').style.display='none'; }
    }
    ['f_title','f_body','f_cta','f_image','f_variant'].forEach(id => F(id).addEventListener('input', renderPreview));

    function blank() {
        F('mTitle').textContent='New advert'; F('f_id').value='';
        ['f_title','f_body','f_image','f_link','f_share','f_starts','f_ends'].forEach(i=>F(i).value='');
        F('f_cta').value='Learn more'; F('f_placement').value='home_banner'; F('f_variant').value='gradient';
        F('f_status').value='draft'; F('f_sort').value='0'; F('f_active').checked=true; F('upStatus').textContent='Upload or paste a URL. Recommended 1200×420.';
        renderPreview();
    }
    F('btnNew').addEventListener('click', () => { blank(); modal.show(); });

    document.querySelectorAll('.btn-edit').forEach(b => b.addEventListener('click', () => {
        const a = JSON.parse(b.dataset.json);
        F('mTitle').textContent='Edit advert'; F('f_id').value=a.id;
        F('f_title').value=a.title||''; F('f_body').value=a.body||''; F('f_image').value=a.image||'';
        F('f_link').value=a.link_url||''; F('f_cta').value=a.cta_label||'Learn more'; F('f_share').value=a.share_caption||'';
        F('f_placement').value=a.placement||'home_banner'; F('f_variant').value=a.variant||'gradient';
        F('f_status').value=a.status||'draft'; F('f_sort').value=a.sort_order||0;
        F('f_starts').value=(a.starts_at||'').slice(0,10); F('f_ends').value=(a.ends_at||'').slice(0,10);
        F('f_active').checked = a.active===1 || a.active===true;
        renderPreview(); modal.show();
    }));

    // Upload
    F('f_file').addEventListener('change', async (e) => {
        const file = e.target.files[0]; if (!file) return;
        F('upStatus').textContent = 'Uploading…';
        const fd = new FormData(); fd.append('image', file);
        const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const r = await fetch('/admin/api/upload/ad', {method:'POST', headers:{'x-csrf-token':csrf}, body:fd}).then(r=>r.json()).catch(()=>({ok:false}));
        if (r.ok) { F('f_image').value = r.data.url; F('upStatus').textContent='Uploaded ✓'; renderPreview(); }
        else { F('upStatus').textContent='Upload failed'; AdminAPI.toast(r.message||'Upload failed', true); }
    });

    F('btnSave').addEventListener('click', async () => {
        const payload = {
            title:F('f_title').value.trim(), body:F('f_body').value.trim(), image:F('f_image').value.trim(),
            link_url:F('f_link').value.trim(), cta_label:F('f_cta').value.trim()||'Learn more', share_caption:F('f_share').value.trim(),
            placement:F('f_placement').value, variant:F('f_variant').value, status:F('f_status').value,
            sort_order:parseInt(F('f_sort').value,10)||0, starts_at:F('f_starts').value||'', ends_at:F('f_ends').value||'',
            active:F('f_active').checked,
        };
        if (!payload.title) return AdminAPI.toast('Title is required', true);
        const id = F('f_id').value;
        const r = id ? await AdminAPI.patch('/ads/'+id, payload) : await AdminAPI.post('/ads', payload);
        if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true);
    });

    document.querySelectorAll('.btn-dup').forEach(b => b.addEventListener('click', async () => {
        const r = await AdminAPI.post('/ads/'+b.dataset.id+'/duplicate'); if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true);
    }));
    document.querySelectorAll('.btn-del').forEach(b => b.addEventListener('click', async () => {
        if (!confirm('Delete this advert?')) return;
        const r = await AdminAPI.del('/ads/'+b.dataset.id); if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true);
    }));

    // Share intents
    const SHARE = (caption, link) => {
        const c = encodeURIComponent(caption); const l = encodeURIComponent(link || 'https://www.greyinfotech.com.ng');
        const full = encodeURIComponent((caption + (link ? ' ' + link : '')));
        return [
            {n:'Facebook', c:'#1877f2', i:'ti-brand-facebook', u:`https://www.facebook.com/sharer/sharer.php?u=${l}&quote=${c}`},
            {n:'X', c:'#000', i:'ti-brand-x', u:`https://twitter.com/intent/tweet?text=${c}&url=${l}`},
            {n:'LinkedIn', c:'#0a66c2', i:'ti-brand-linkedin', u:`https://www.linkedin.com/sharing/share-offsite/?url=${l}`},
            {n:'WhatsApp', c:'#25d366', i:'ti-brand-whatsapp', u:`https://wa.me/?text=${full}`},
            {n:'Telegram', c:'#229ed9', i:'ti-brand-telegram', u:`https://t.me/share/url?url=${l}&text=${c}`},
            {n:'Instagram', c:'#e1306c', i:'ti-brand-instagram', u:`https://www.instagram.com/greyinfotechltd/`},
        ];
    };
    let curCaption='', curLink='';
    document.querySelectorAll('.btn-share').forEach(b => b.addEventListener('click', () => {
        curCaption=b.dataset.caption||''; curLink=b.dataset.link||'';
        const host=F('shareBtns'); host.innerHTML='';
        SHARE(curCaption, curLink).forEach(s => {
            const a=document.createElement('a'); a.href=s.u; a.target='_blank'; a.rel='noopener';
            a.className='share-btn'; a.style.background=s.c; a.title=s.n; a.innerHTML=`<i class="ti ${s.i}"></i>`;
            host.appendChild(a);
        });
        shareModal.show();
    }));
    F('copyCap').addEventListener('click', () => {
        navigator.clipboard.writeText(curCaption + (curLink?' '+curLink:'')).then(()=>AdminAPI.toast('Caption copied'));
    });
})();
</script>
