<%- contentFor('html_attribute') %>
<%- contentFor('extra_css') %>
<%- contentFor('content') %>

<%- include('./partials/page-title', { title: title, subtitle: 'Careers' }) %>

<!-- Stats row -->
<div class="row g-3 mb-4">
    <%
    const published = openings.filter(o => o.status === 'published').length;
    const draft = openings.filter(o => o.status === 'draft').length;
    const closed = openings.filter(o => o.status === 'closed').length;
    %>
    <div class="col-sm-4">
        <div class="card text-center py-3">
            <div class="card-body">
                <h3 class="mb-1 text-success fw-bold"><%= published %></h3>
                <p class="mb-0 text-muted fs-13">Published</p>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center py-3">
            <div class="card-body">
                <h3 class="mb-1 text-warning fw-bold"><%= draft %></h3>
                <p class="mb-0 text-muted fs-13">Drafts</p>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center py-3">
            <div class="card-body">
                <h3 class="mb-1 text-secondary fw-bold"><%= closed %></h3>
                <p class="mb-0 text-muted fs-13">Closed</p>
            </div>
        </div>
    </div>
</div>

<!-- Job openings list -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="card-title mb-0">
                    <i class="ti ti-briefcase me-1"></i>
                    Job Openings
                    <span class="badge bg-primary-subtle text-primary ms-1"><%= openings.length %></span>
                </h4>
                <button class="btn btn-sm btn-primary" id="btnNew">
                    <i class="ti ti-plus"></i> New Job Opening
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-centered mb-0">
                    <thead class="bg-light bg-opacity-50">
                        <tr>
                            <th>Title</th>
                            <th>Department</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Deadline</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!openings.length) { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="ti ti-briefcase-off fs-24 d-block mb-2"></i>
                                No job openings yet. Click "New Job Opening" to create one.
                            </td>
                        </tr>
                        <% } %>
                        <% openings.forEach(function(j) { %>
                        <tr>
                            <td>
                                <span class="fw-semibold"><%- (j.title||'').replace(/</g,'&lt;') %></span>
                                <% if (j.experience_level) { %><br><small class="text-muted"><%- (j.experience_level||'').replace(/</g,'&lt;') %></small><% } %>
                            </td>
                            <td><span class="text-muted fs-13"><%- (j.department||'—').replace(/</g,'&lt;') %></span></td>
                            <td>
                                <i class="ti ti-map-pin me-1 text-muted fs-12"></i>
                                <span class="fs-13"><%- (j.location||'—').replace(/</g,'&lt;') %></span>
                            </td>
                            <td>
                                <%
                                const typeBadge = {
                                    'full-time': 'primary', 'part-time': 'info',
                                    'contract': 'warning', 'remote': 'success'
                                }[j.type] || 'secondary';
                                %>
                                <span class="badge bg-<%= typeBadge %>-subtle text-<%= typeBadge %> text-capitalize"><%= j.type %></span>
                            </td>
                            <td>
                                <%
                                const statusBadge = {published:'success',draft:'warning',closed:'secondary'}[j.status]||'secondary';
                                %>
                                <span class="badge bg-<%= statusBadge %>-subtle text-<%= statusBadge %> text-capitalize"><%= j.status %></span>
                            </td>
                            <td class="fs-13 text-muted">
                                <%= j.deadline ? j.deadline : '—' %>
                            </td>
                            <td class="fs-13 text-muted"><%= timeAgo(j.created_at) %></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-soft-primary btn-edit"
                                    data-id="<%= j.id %>"
                                    data-title="<%- (j.title||'').replace(/"/g,'&quot;') %>"
                                    data-department="<%- (j.department||'').replace(/"/g,'&quot;') %>"
                                    data-location="<%- (j.location||'Remote').replace(/"/g,'&quot;') %>"
                                    data-type="<%= j.type %>"
                                    data-experience="<%- (j.experience_level||'').replace(/"/g,'&quot;') %>"
                                    data-salary="<%- (j.salary_range||'').replace(/"/g,'&quot;') %>"
                                    data-description="<%- (j.description||'').replace(/"/g,'&quot;').replace(/\n/g,'&#10;') %>"
                                    data-responsibilities="<%- (j.responsibilities||'[]').replace(/"/g,'&quot;') %>"
                                    data-requirements="<%- (j.requirements||'[]').replace(/"/g,'&quot;') %>"
                                    data-nicetohave="<%- (j.nice_to_have||'[]').replace(/"/g,'&quot;') %>"
                                    data-benefits="<%- (j.benefits||'[]').replace(/"/g,'&quot;') %>"
                                    data-status="<%= j.status %>"
                                    data-deadline="<%= j.deadline||'' %>">
                                    <i class="ti ti-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-soft-danger btn-del" data-id="<%= j.id %>">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create / Edit Modal -->
<div class="modal fade" id="jobModal" tabindex="-1" aria-labelledby="jobModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="jobModalLabel">New Job Opening</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="jobForm" novalidate>
                    <input type="hidden" id="fId" value="">

                    <!-- Row 1: Title + Department -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Job Title <span class="text-danger">*</span></label>
                            <input type="text" id="fTitle" class="form-control" placeholder="e.g. Senior Full-Stack Developer" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Department</label>
                            <input type="text" id="fDepartment" class="form-control" placeholder="e.g. Engineering, Design, Marketing">
                        </div>
                    </div>

                    <!-- Row 2: Location + Type + Experience + Salary -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Location</label>
                            <input type="text" id="fLocation" class="form-control" placeholder="Lagos / Remote">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Job Type</label>
                            <select id="fType" class="form-select">
                                <option value="full-time">Full-time</option>
                                <option value="part-time">Part-time</option>
                                <option value="contract">Contract</option>
                                <option value="remote">Remote</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Experience Level</label>
                            <input type="text" id="fExperience" class="form-control" placeholder="e.g. 3–5 years">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Salary Range</label>
                            <input type="text" id="fSalary" class="form-control" placeholder="e.g. ₦400k–₦700k/mo">
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description / About the Role</label>
                        <textarea id="fDescription" class="form-control" rows="4"
                            placeholder="Describe the role, the team, and the impact this person will have..."></textarea>
                    </div>

                    <!-- Responsibilities -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Responsibilities
                            <small class="text-muted fw-normal ms-1">(one per line)</small>
                        </label>
                        <textarea id="fResponsibilities" class="form-control" rows="5"
                            placeholder="Design and implement scalable backend APIs&#10;Collaborate with product and design teams&#10;..."></textarea>
                    </div>

                    <!-- Requirements -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Requirements
                            <small class="text-muted fw-normal ms-1">(one per line)</small>
                        </label>
                        <textarea id="fRequirements" class="form-control" rows="5"
                            placeholder="3+ years of professional experience with React&#10;Strong understanding of RESTful APIs&#10;..."></textarea>
                    </div>

                    <!-- Nice to Have -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Nice to Have
                            <small class="text-muted fw-normal ms-1">(one per line, optional)</small>
                        </label>
                        <textarea id="fNiceToHave" class="form-control" rows="3"
                            placeholder="Experience with Docker / Kubernetes&#10;Open source contributions&#10;..."></textarea>
                    </div>

                    <!-- Benefits -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Benefits
                            <small class="text-muted fw-normal ms-1">(one per line)</small>
                        </label>
                        <textarea id="fBenefits" class="form-control" rows="3"
                            placeholder="Competitive salary&#10;Remote-first culture&#10;Annual learning budget&#10;..."></textarea>
                    </div>

                    <!-- Row last: Status + Deadline -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select id="fStatus" class="form-select">
                                <option value="draft">Draft</option>
                                <option value="published">Published</option>
                                <option value="closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Application Deadline</label>
                            <input type="date" id="fDeadline" class="form-control">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="ti ti-device-floppy me-1"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete confirm modal -->
<div class="modal fade" id="delModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <i class="ti ti-alert-triangle text-danger fs-36 mb-3 d-block"></i>
                <h5>Delete this job opening?</h5>
                <p class="text-muted fs-13">This cannot be undone. Applications linked to it will still remain.</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pb-4 pt-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" id="btnConfirmDel">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    const jobModal = new bootstrap.Modal(document.getElementById('jobModal'));
    const delModal = new bootstrap.Modal(document.getElementById('delModal'));

    let editId = null;
    let deleteId = null;

    /* helpers */
    const arrToLines = (jsonStr) => {
        try {
            const arr = JSON.parse(jsonStr);
            return Array.isArray(arr) ? arr.join('\n') : jsonStr || '';
        } catch { return jsonStr || ''; }
    };

    const linesToArr = (str) =>
        str.split('\n').map(s => s.trim()).filter(Boolean);

    const toast = (msg, type = 'success') => {
        const el = document.createElement('div');
        el.className = `alert alert-${type} alert-dismissible position-fixed bottom-0 end-0 m-3`;
        el.style.zIndex = 9999;
        el.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 4000);
    };

    /* Open "New" modal */
    document.getElementById('btnNew').addEventListener('click', () => {
        editId = null;
        document.getElementById('jobModalLabel').textContent = 'New Job Opening';
        document.getElementById('jobForm').reset();
        document.getElementById('fId').value = '';
        document.getElementById('fLocation').value = 'Remote';
        document.getElementById('fType').value = 'full-time';
        document.getElementById('fStatus').value = 'draft';
        jobModal.show();
    });

    /* Open "Edit" modal */
    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', () => {
            editId = btn.dataset.id;
            document.getElementById('jobModalLabel').textContent = 'Edit Job Opening';
            document.getElementById('fId').value = editId;
            document.getElementById('fTitle').value = btn.dataset.title || '';
            document.getElementById('fDepartment').value = btn.dataset.department || '';
            document.getElementById('fLocation').value = btn.dataset.location || 'Remote';
            document.getElementById('fType').value = btn.dataset.type || 'full-time';
            document.getElementById('fExperience').value = btn.dataset.experience || '';
            document.getElementById('fSalary').value = btn.dataset.salary || '';
            document.getElementById('fDescription').value = (btn.dataset.description || '').replace(/&#10;/g, '\n');
            document.getElementById('fResponsibilities').value = arrToLines(btn.dataset.responsibilities || '[]');
            document.getElementById('fRequirements').value = arrToLines(btn.dataset.requirements || '[]');
            document.getElementById('fNiceToHave').value = arrToLines(btn.dataset.nicetohave || '[]');
            document.getElementById('fBenefits').value = arrToLines(btn.dataset.benefits || '[]');
            document.getElementById('fStatus').value = btn.dataset.status || 'draft';
            document.getElementById('fDeadline').value = btn.dataset.deadline || '';
            jobModal.show();
        });
    });

    /* Save */
    document.getElementById('btnSave').addEventListener('click', async () => {
        const title = document.getElementById('fTitle').value.trim();
        if (!title) { toast('Job title is required.', 'danger'); return; }

        const id = document.getElementById('fId').value;
        const isEdit = !!id;
        const url = isEdit ? `/api/admin/job-openings/${id}` : '/api/admin/job-openings';
        const method = isEdit ? 'PUT' : 'POST';

        const payload = {
            title,
            department: document.getElementById('fDepartment').value.trim(),
            location: document.getElementById('fLocation').value.trim() || 'Remote',
            type: document.getElementById('fType').value,
            experience_level: document.getElementById('fExperience').value.trim(),
            salary_range: document.getElementById('fSalary').value.trim(),
            description: document.getElementById('fDescription').value.trim(),
            responsibilities: linesToArr(document.getElementById('fResponsibilities').value),
            requirements: linesToArr(document.getElementById('fRequirements').value),
            nice_to_have: linesToArr(document.getElementById('fNiceToHave').value),
            benefits: linesToArr(document.getElementById('fBenefits').value),
            status: document.getElementById('fStatus').value,
            deadline: document.getElementById('fDeadline').value || null,
        };

        const btn = document.getElementById('btnSave');
        btn.disabled = true;
        btn.textContent = 'Saving…';

        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok || !data.ok) throw new Error(data.message || 'Error saving');
            toast(isEdit ? 'Job opening updated.' : 'Job opening created.');
            jobModal.hide();
            setTimeout(() => location.reload(), 800);
        } catch (e) {
            toast(e.message || 'Something went wrong.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="ti ti-device-floppy me-1"></i> Save';
        }
    });

    /* Delete — confirm */
    document.querySelectorAll('.btn-del').forEach(btn => {
        btn.addEventListener('click', () => {
            deleteId = btn.dataset.id;
            delModal.show();
        });
    });

    document.getElementById('btnConfirmDel').addEventListener('click', async () => {
        if (!deleteId) return;
        try {
            const res = await fetch(`/api/admin/job-openings/${deleteId}`, { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok || !data.ok) throw new Error(data.message || 'Error deleting');
            toast('Job opening deleted.');
            delModal.hide();
            setTimeout(() => location.reload(), 800);
        } catch (e) {
            toast(e.message || 'Something went wrong.', 'danger');
        }
    });
})();
</script>
