<%- contentFor('html_attribute') %>
<%- contentFor('extra_css') %>
<%- contentFor('content') %>

<%- include('./partials/page-title', { title: title, subtitle: 'Marketing' }) %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="card-title mb-0"><i class="ti ti-bell-ringing me-1"></i> Announcement Bars <span class="badge bg-primary-subtle text-primary ms-1"><%= announcements.length %></span></h4>
                <button class="btn btn-sm btn-primary" id="btnNew"><i class="ti ti-plus"></i> New announcement</button>
            </div>
            <div class="card-body"><p class="text-muted fs-13 mb-0">Only the most recent <strong>active</strong> announcement (within its schedule) shows on the site, as a thin bar above the header.</p></div>
            <div class="table-responsive">
                <table class="table table-hover table-centered mb-0 align-middle">
                    <thead class="bg-light bg-opacity-50"><tr><th>Message</th><th>Variant</th><th>Schedule</th><th>Active</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                        <% if (!announcements.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No announcements yet.</td></tr><% } %>
                        <% announcements.forEach((a) => { %>
                        <tr>
                            <td class="fw-medium"><%= a.message %><% if (a.link_label) { %> <span class="badge bg-info-subtle text-info"><%= a.link_label %></span><% } %></td>
                            <td><span class="badge bg-<%= ({info:'info',success:'success',warning:'warning',promo:'primary'})[a.variant]||'secondary' %>-subtle text-<%= ({info:'info',success:'success',warning:'warning',promo:'primary'})[a.variant]||'secondary' %>"><%= a.variant %></span></td>
                            <td class="fs-12 text-muted"><%= a.starts_at ? a.starts_at.slice(0,10) : '—' %> → <%= a.ends_at ? a.ends_at.slice(0,10) : '∞' %></td>
                            <td><span class="badge bg-<%= a.active?'success':'secondary' %>-subtle text-<%= a.active?'success':'secondary' %>"><%= a.active?'Active':'Off' %></span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-soft-primary btn-edit" data-json="<%- JSON.stringify(a).replace(/"/g,'&quot;') %>"><i class="ti ti-edit"></i></button>
                                <button class="btn btn-sm btn-soft-danger btn-del" data-id="<%= a.id %>"><i class="ti ti-trash"></i></button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="aModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header border-bottom"><h5 class="modal-title" id="mTitle">New announcement</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><input type="hidden" id="f_id"><div class="row g-3">
        <div class="col-12"><label class="form-label fw-medium">Message <span class="text-danger">*</span></label><input id="f_msg" class="form-control" placeholder="e.g. 🎉 We just launched our new cloud platform"></div>
        <div class="col-md-6"><label class="form-label fw-medium">Link label</label><input id="f_label" class="form-control" placeholder="Learn more"></div>
        <div class="col-md-6"><label class="form-label fw-medium">Link URL</label><input id="f_url" class="form-control" placeholder="https://..."></div>
        <div class="col-md-4"><label class="form-label fw-medium">Variant</label><select id="f_variant" class="form-select"><option value="info">Info</option><option value="success">Success</option><option value="warning">Warning</option><option value="promo">Promo</option></select></div>
        <div class="col-md-4"><label class="form-label fw-medium">Starts</label><input id="f_starts" type="date" class="form-control"></div>
        <div class="col-md-4"><label class="form-label fw-medium">Ends</label><input id="f_ends" type="date" class="form-control"></div>
        <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="f_active" checked><label class="form-check-label fw-medium" for="f_active">Active</label></div></div>
    </div></div>
    <div class="modal-footer border-top"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="btnSave"><i class="ti ti-device-floppy me-1"></i>Save</button></div>
</div></div></div>

<%- contentFor('extra_javascript') %>
<%- include('./partials/admin-api-helper') %>
<script>
(function () {
    const modal=new bootstrap.Modal('#aModal'); const F=(id)=>document.getElementById(id);
    F('btnNew').addEventListener('click', () => { F('mTitle').textContent='New announcement'; F('f_id').value=''; ['f_msg','f_label','f_url','f_starts','f_ends'].forEach(i=>F(i).value=''); F('f_variant').value='info'; F('f_active').checked=true; modal.show(); });
    document.querySelectorAll('.btn-edit').forEach(b => b.addEventListener('click', () => {
        const a=JSON.parse(b.dataset.json); F('mTitle').textContent='Edit announcement'; F('f_id').value=a.id;
        F('f_msg').value=a.message||''; F('f_label').value=a.link_label||''; F('f_url').value=a.link_url||''; F('f_variant').value=a.variant||'info';
        F('f_starts').value=(a.starts_at||'').slice(0,10); F('f_ends').value=(a.ends_at||'').slice(0,10); F('f_active').checked=a.active===1||a.active===true; modal.show();
    }));
    document.querySelectorAll('.btn-del').forEach(b => b.addEventListener('click', async () => { if (!confirm('Delete?')) return; const r = await AdminAPI.del('/announcements/'+b.dataset.id); if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true); }));
    F('btnSave').addEventListener('click', async () => {
        const payload = { message:F('f_msg').value.trim(), link_label:F('f_label').value.trim(), link_url:F('f_url').value.trim(), variant:F('f_variant').value, starts_at:F('f_starts').value||'', ends_at:F('f_ends').value||'', active:F('f_active').checked };
        if (!payload.message) return AdminAPI.toast('Message is required', true);
        const id=F('f_id').value; const r = id ? await AdminAPI.patch('/announcements/'+id, payload) : await AdminAPI.post('/announcements', payload);
        if (r.ok) location.reload(); else AdminAPI.toast(r.message||'Failed', true);
    });
})();
</script>
