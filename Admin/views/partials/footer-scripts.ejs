<!-- Real-time admin updates via SSE -->
<script>
    (function () {
        'use strict';
        if (typeof EventSource === 'undefined') return;

        let es;
        let retryDelay = 3000;

        // Initialize notification badge on page load
        function initNotificationBadge() {
            fetch('/api/notifications?status=unread&limit=1')
                .then(r => r.json())
                .then(res => {
                    if (res.ok && res.pagination) {
                        updateBadge('.noti-icon-badge', res.pagination.total);
                    }
                })
                .catch(() => {
                    /* ignore fetch errors */
                });
        }

        function connect() {
            es = new EventSource('/admin/events');

            es.addEventListener('connected', () => {
                retryDelay = 3000; // reset backoff on successful connect
            });

            // ── Stats refresh ──────────────────────────────────────────────────
            es.addEventListener('stats', (e) => {
                try {
                    const s = JSON.parse(e.data);
                    updateBadge('[data-badge="newSubmissions"]', s.newSubmissions);
                    updateBadge('[data-badge="openTickets"]', s.openTickets);
                    updateBadge('[data-badge="unreadConvos"]', s.unreadConvos);
                } catch { /* ignore parse errors */
                }
            });

            // ── New ticket: toast + page refresh if on tickets page ───────────
            es.addEventListener('ticket', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('New ticket', `"${d.ticket?.subject || 'Support request'}" just came in.`, 'ti-ticket', 'warning');
                        if (location.pathname.includes('/tickets')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── New submission ─────────────────────────────────────────────────
            es.addEventListener('submission', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('New submission', 'A new contact form submission arrived.', 'ti-mail', 'info');
                        if (location.pathname.includes('/submissions')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── New lead ───────────────────────────────────────────────────────
            es.addEventListener('lead', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('New lead', `${d.lead?.name || 'Someone'} entered the pipeline.`, 'ti-target-arrow', 'success');
                        if (location.pathname.includes('/leads')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── New notification ────────────────────────────────────────────────
            es.addEventListener('notification', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        const {title, message, type} = d;
                        showToast(title || 'Notification', message || 'You have a new notification', 'ti-bell', type || 'info');
                        // Update notification badge
                        updateBadge('.noti-icon-badge', d.unreadCount || 1);
                        if (location.pathname.includes('/notifications')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── New audit request ───────────────────────────────────────────────
            es.addEventListener('audit', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('New Audit Request', `Audit request from ${d.name || 'Someone'} received.`, 'ti-search-alt', 'info');
                        if (location.pathname.includes('/audits')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── New sale/payment ────────────────────────────────────────────────
            es.addEventListener('sale', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('New Sale', `New order #${d.id} received.`, 'ti-shopping-cart', 'success');
                        if (location.pathname.includes('/orders') || location.pathname.includes('/sales')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            // ── Ad click tracked ────────────────────────────────────────────────
            es.addEventListener('ad_click', (e) => {
                try {
                    const d = JSON.parse(e.data);
                    if (d.action === 'create') {
                        showToast('Ad Click', `Ad "${d.name}" was clicked.`, 'ti-pointer', 'warning');
                        if (location.pathname.includes('/ads')) {
                            setTimeout(() => location.reload(), 1500);
                        }
                    }
                } catch { /* ignore */
                }
            });

            es.onerror = () => {
                es.close();
                // Exponential back-off: 3s → 6s → 12s → … capped at 60s
                setTimeout(connect, retryDelay = Math.min(retryDelay * 2, 60000));
            };
        }

        // ── Helpers ─────────────────────────────────────────────────────────────

        function updateBadge(selector, count) {
            document.querySelectorAll(selector).forEach(el => {
                el.textContent = count > 99 ? '99+' : (count || '');
                el.style.display = count > 0 ? '' : 'none';
            });
        }

        function showToast(title, message, icon, type) {
            // Use Bootstrap toast if available, otherwise fall back to console
            const toastContainer = document.getElementById('sse-toast-container');
            if (!toastContainer) return;
            const id = 'toast-' + Date.now();
            const colors = {warning: 'text-warning', info: 'text-info', success: 'text-success', danger: 'text-danger'};
            toastContainer.insertAdjacentHTML('beforeend', `
            <div id="${id}" class="toast align-items-center border-0 shadow" role="alert" aria-live="assertive">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="ti ${icon} fs-18 ${colors[type] || ''}"></i>
                        <div><strong>${title}</strong><br><span class="fs-13 text-muted">${message}</span></div>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>`);
            const el = document.getElementById(id);
            const toast = new bootstrap.Toast(el, {delay: 6000});
            toast.show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        connect();
        initNotificationBadge();
    })();
</script>

<!--
  Modal stacking fix.
  The admin layout wraps content in `.page-content`/`.page-container`, both of
  which are `position:relative; z-index:1` and therefore create their own
  stacking contexts. A Bootstrap `.modal` (z-index ~1055) nested inside that
  context is trapped, while Bootstrap appends `.modal-backdrop` directly to
  <body> (z-index 1050) — so the backdrop paints OVER the modal, leaving the
  screen dimmed and every control (incl. the Save button) unclickable
  ("blur and stuck").

  Fix: reparent each modal to <body> right before it shows so it escapes the
  trapped stacking context and sits above its own backdrop. Applies globally to
  every admin "Add / Edit" modal (FAQs, blog, reviews, ads, case studies, etc.).
-->
<script>
    (function () {
        'use strict';
        function moveToBody(modalEl) {
            if (modalEl && modalEl.parentElement !== document.body) {
                document.body.appendChild(modalEl);
            }
        }
        // Catch any modal as it begins to open (event bubbles to document).
        document.addEventListener('show.bs.modal', function (ev) {
            moveToBody(ev.target);
        }, true);
        // Safety net: also move all existing modals once Bootstrap is ready.
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.modal').forEach(moveToBody);
        });
    })();
</script>

