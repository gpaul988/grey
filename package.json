{
  "name": "grey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "dev:next": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "start:next": "next start -p 3000",
    "seed": "tsx Admin/db/seed.ts",
    "seed:reset": "rm -f Admin/data/grey.db && tsx Admin/db/seed.ts",
    "migrate-admin-assets": "node scripts/migrate-admin-assets.js",
    "lint": "eslint . --fix",
    "rebuild:sqlite": "npm rebuild better-sqlite3 --build-from-source",
    "install:prod": "npm install --legacy-peer-deps --no-audit --no-fund --prefer-offline",
    "install:cpanel": "npm install --ignore-scripts --legacy-peer-deps",
    "cpanel:full": "bash scripts/cpanel-install.sh",
    "clean": "rm -rf node_modules .next package-lock.json && npm cache clean --force",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
