    "@testing-library/react": "^16.3.2",
    "@vitest/ui": "^4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-session-store": "^0.1.0",
    "connect-redis": "^9.0.0",
