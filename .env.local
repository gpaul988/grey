# Development Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database (SQLite - no external DB needed)
DATABASE_URL=file:./Admin/data/grey.db

# Session & Security
SESSION_SECRET=prod-session-secret-change-in-cpanel-2024
CSRF_SECRET=prod-csrf-secret-change-in-cpanel-2024

# API Keys (Stripe - test keys, replace with prod in cPanel)
STRIPE_PUBLIC_KEY=pk_test_51234567890abcdefghijk
STRIPE_SECRET_KEY=sk_test_987654321zyxwvutsrqp

# PayPal (test credentials, replace with prod)
PAYPAL_CLIENT_ID=test_client_id_change_in_cpanel
PAYPAL_CLIENT_SECRET=test_client_secret_change_in_cpanel

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@greyinfotech.com.ng
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@greyinfotech.com.ng

# Seed Database Credentials (REQUIRED - change in cPanel)
SEED_SUPERADMIN_PASSWORD=ChangeThisInCPanel2024!
SEED_ADMIN_PASSWORD=ChangeAdminPass2024!
SEED_MANAGER_PASSWORD=ChangeManagerPass2024!
SEED_STAFF_PASSWORD=ChangeStaffPass2024!
SEED_ADMIN_EMAIL=admin@greyinfotech.com.ng

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
RECAPTCHA_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# Next.js Public API URL (local development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# GitHub Token (optional, for code analyzer feature)
# IMPORTANT: Set this in cPanel environment, not in version control
GITHUB_TOKEN=
