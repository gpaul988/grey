# Environment Configuration Template
# Copy this file to .env.local and fill in actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database
DATABASE_URL=file:./Admin/data/grey.db

# Session Configuration
SESSION_SECRET=your-secure-session-secret-here-change-in-production

# API Keys (if using external services)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Email Configuration (if using Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@greyinfotech.com.ng

# GitHub Token (for git operations, development only)
GITHUB_TOKEN=your-github-personal-access-token

# Logging
LOG_LEVEL=info

# Security
CSRF_SECRET=your-csrf-secret-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
RECAPTCHA_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# Next.js Specific
NEXT_PUBLIC_API_URL=http://localhost:3000
