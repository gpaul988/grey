# Environment Configuration Template
# Copy this file to .env.local and fill in actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database
DATABASE_URL=file:./Admin/data/grey.db

# Session Configuration
SESSION_SECRET=your-secure-session-secret-here-change-in-production

# API Keys (if using external services)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Email Configuration (if using Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@greyinfotech.com.ng

# GitHub Token (for git operations, development only)
GITHUB_TOKEN=your-github-personal-access-token

# Seed Database Credentials (REQUIRED for running seed)
# ⚠️ CRITICAL: These are PRODUCTION credentials. Never commit actual passwords.
# Set in .env.local (git-ignored) or your deployment environment only.
SEED_SUPERADMIN_PASSWORD=change-this-to-a-strong-password
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password
SEED_MANAGER_PASSWORD=change-this-to-a-strong-password
SEED_STAFF_PASSWORD=change-this-to-a-strong-password

# Optional: Override default seed admin email (default: admin@greyinfotech.com.ng)
SEED_ADMIN_EMAIL=admin@greyinfotech.com.ng

# Logging
LOG_LEVEL=info

# Security
CSRF_SECRET=your-csrf-secret-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
RECAPTCHA_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# Next.js Specific
NEXT_PUBLIC_API_URL=http://localhost:3000

# Phase 2: Database & Caching
DATABASE_URL=postgresql://grey:password@localhost:5432/grey
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=your-256-bit-encryption-key-hex-64-chars
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=100

# Session configuration
SESSION_SECRET=your-session-secret-here
SESSION_TIMEOUT=86400000

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# Phase 2: Database & Caching
DATABASE_URL=postgresql://grey:password@localhost:5432/grey
