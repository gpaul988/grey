# ─── Grey InfoTech — Environment Variables ───────────────────────────────────
# DEPLOY STEP (required):  cp config.env.example config.env   then fill values.
# config.env holds LIVE secrets and is NOT committed to git. Without it the app
# starts but every secret is empty (payments/email/sessions break silently).
#
# In PRODUCTION the app refuses to start without strong (>=16 char) secrets for
# SESSION_SECRET / CSRF_SECRET. Generate with:  openssl rand -base64 32

NODE_ENV=production
PORT=3000

# Public base URLs (used for redirects, emails and payment callbacks/webhooks)
FRONTEND_BASE_URL=https://greyinfotech.com.ng
BACKEND_BASE_URL=https://greyinfotech.com.ng/admin

# ── Security (REQUIRED in production) ──
SESSION_SECRET=
CSRF_SECRET=
# Optional: separate secret for customer/store sessions (falls back to SESSION_SECRET)
CUSTOMER_SESSION_SECRET=

# ── AI assistant (OPTIONAL) ──
# If unset, the AI chatbot uses a built-in local knowledge-base answerer (free,
# no external calls). Set these to enable streamed LLM answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── SMTP (contact / tickets email) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Store payment gateways (set the ones you use; LIVE keys) ──
# Paystack — set webhook URL in dashboard to: {BACKEND_BASE_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave — webhook URL: {BACKEND_BASE_URL}/api/webhooks/flutterwave
# FLUTTERWAVE_WEBHOOK_HASH must match the "Secret hash" set in the FLW dashboard.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Monnify — webhook URL: {BACKEND_BASE_URL}/api/webhooks/monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
